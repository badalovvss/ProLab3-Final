@{
    ViewData["Title"] = "Yardım";
    ViewData["AktifMenu"] = "";
    Layout = "~/Views/Shared/_PanelLayout.cshtml";
}

<div class="dashboard">

    <div class="page-heading">

        <div>

            <p class="page-label">ÖĞRENCİ PANELİ</p>

            <h1>Yardım</h1>

            <p class="page-description">
                Sistemin kullanımı hakkında temel bilgileri
                bu sayfada bulabilirsiniz.
            </p>

        </div>

        <span class="preview-badge">
            Arayüz önizlemesi
        </span>

    </div>


    <section class="wide-card">

        <div class="section-heading">

            <div>

                <h2>
                    Staj bilgilerimi nereden girebilirim?
                </h2>

            </div>

        </div>

        <div class="card-content">

            <p class="bilgi-metni">
                Sol menüdeki <strong>Staj Bilgileri</strong> sayfasından
                başlangıç ve bitiş tarihlerini ve haftalık staj günlerini
                seçebilirsiniz.
            </p>

        </div>

    </section>


    <section class="wide-card">

        <div class="section-heading">

            <div>

                <h2>
                    Hangi dosya türlerini seçebilirim?
                </h2>

            </div>

        </div>

        <div class="card-content">

            <p class="bilgi-metni">
                Ek-16 belgesi için Word, PDF, JPEG ve PNG biçimleri
                kullanılabilir.
            </p>

            <p class="status-note">
                Desteklenen uzantılar:
                .doc, .docx, .pdf, .jpg, .jpeg ve .png
            </p>

        </div>

    </section>


    <section class="wide-card">

        <div class="section-heading">

            <div>

                <h2>
                    Kontrol sonucunu nereden görebilirim?
                </h2>

            </div>

        </div>

        <div class="card-content">

            <p class="bilgi-metni">
                Kontrol sonuçları, backend bağlantısı tamamlandığında
                sol menüdeki <strong>Kontrol Sonucu</strong> sayfasında
                gösterilecektir.
            </p>

        </div>

    </section>


    <section class="wide-card">

        <div class="section-heading">

            <div>

                <h2>
                    Önizleme hakkında
                </h2>

            </div>

        </div>

        <div class="card-content">

            <p class="bilgi-metni">
                Bu sürüm arayüz önizlemesidir. Seçilen dosyalar ve
                girilen bilgiler şu anda sunucuya kaydedilmez.
            </p>

        </div>

    </section>

</div>