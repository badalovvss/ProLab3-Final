@{
    var aktifMenu = ViewData["AktifMenu"]?.ToString() ?? "";

    // Öğrenci adını doğrudan Session'dan alıyoruz (OgrenciController Profil metodundan beslenecek)
    var ogrenciAdi = Context.Session.GetString("OgrenciAdSoyad") ?? "Öğrenci";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Staj Evrak Yönetimi</title>
    <link rel="stylesheet" href="/css/panel.css" />
    <link rel="stylesheet" href="/css/ogrenci-sayfalari.css" />
    <link rel="stylesheet" href="/css/ust-panel.css" />
</head>
<body>

    <!-- ORTAK SİMGELER -->
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;" aria-hidden="true">
        <symbol id="icon-home" viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5" /><path d="M5.5 9.5V21h13V9.5" /><path d="M9.5 21v-7h5v7" /></symbol>
        <symbol id="icon-document" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z" /><path d="M14 3v5h4" /><path d="M9 12h6M9 16h6" /></symbol>
        <symbol id="icon-upload" viewBox="0 0 24 24"><path d="M12 16V4" /><path d="m8 8 4-4 4 4" /><path d="M5 16v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3" /></symbol>
        <symbol id="icon-check" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="3" /><path d="m8 12 2.5 2.5L16 9" /></symbol>
        <symbol id="icon-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4M17 3v4M3 10h18" /></symbol>
        <symbol id="icon-external" viewBox="0 0 24 24"><path d="M13 5h6v6" /><path d="M19 5 10 14" /><path d="M19 14v5H5V5h5" /></symbol>
        <symbol id="icon-exit" viewBox="0 0 24 24"><path d="M10 4H5v16h5" /><path d="M13 8l4 4-4 4" /><path d="M8 12h9" /></symbol>
        <symbol id="icon-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5" /><path d="M5 20v-1a7 7 0 0 1 14 0v1" /></symbol>
        <symbol id="icon-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.5 2.5 0 1 1 4 2c-.9.6-1.5 1.1-1.5 2" /><path d="M12 17h.01" /></symbol>
        <symbol id="icon-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></symbol>
        <symbol id="icon-chevron" viewBox="0 0 24 24"><path d="m7 10 5 5 5-5" /></symbol>
    </svg>

    <div class="app">

        <!-- =====================================
             ÜST BAŞLIK
        ====================================== -->
        <header class="topbar">
            <div class="topbar-title">
                Staj Evrak Doğrulama ve Yönetim Sistemi
            </div>
            <div class="topbar-right">

                <!-- YARDIM (Şimdilik boş kalabilir) -->
                <a class="header-action" href="#">
                    <svg aria-hidden="true"><use href="#icon-help"></use></svg>
                    <span>Yardım</span>
                </a>
                <span class="header-divider"></span>

                <!-- İLETİŞİM (Şimdilik boş kalabilir) -->
                <a class="header-action" href="#">
                    <svg aria-hidden="true"><use href="#icon-mail"></use></svg>
                    <span>İletişim</span>
                </a>
                <span class="header-divider"></span>

                <!-- ÖĞRENCİ MENÜSÜ (Sağ Üst) -->
                <details class="user-dropdown" id="kullaniciMenu">
                    <summary class="user-summary">
                        <span class="user-icon"><svg aria-hidden="true"><use href="#icon-user"></use></svg></span>
                        <span class="user-name">@ogrenciAdi</span>
                        <svg class="user-chevron" aria-hidden="true"><use href="#icon-chevron"></use></svg>
                    </summary>
                    <div class="user-dropdown-content">
                        <div class="user-dropdown-heading">
                            <strong>@ogrenciAdi</strong>
                            <span>Öğrenci paneli</span>
                        </div>

                        <!-- BURASI DÜZELTİLDİ: Gerçek Profil Sayfasına Yönlendirir -->
                        <a class="user-dropdown-link" asp-controller="Ogrenci" asp-action="Profil">
                            <svg aria-hidden="true"><use href="#icon-user"></use></svg>
                            <span>Profilim</span>
                        </a>

                        <!-- BURASI DÜZELTİLDİ: Gerçek Çıkış İşlemine Yönlendirir -->
                        <a class="user-dropdown-link" asp-controller="Auth" asp-action="Logout">
                            <svg aria-hidden="true"><use href="#icon-exit"></use></svg>
                            <span>Çıkış Yap</span>
                        </a>
                    </div>
                </details>
            </div>
        </header>

        <div class="app-body">

            <!-- =================================
                 SOL MENÜ
            ================================== -->
            <aside class="sidebar">
                <nav class="sidebar-nav" aria-label="Öğrenci menüsü">

                    <!-- Ana Sayfa Linki (Henüz backend'de yoksa Profil'e yollayabiliriz veya böyle kalabilir) -->
                    <a class="sidebar-link @(aktifMenu == "AnaSayfa" ? "active" : "")" asp-controller="Ogrenci" asp-action="Index">
                        <svg aria-hidden="true"><use href="#icon-home"></use></svg>
                        <span>Ana Sayfa</span>
                    </a>

                    <!-- Staj Bilgileri -->
                    <a class="sidebar-link @(aktifMenu == "StajBilgileri" ? "active" : "")" asp-controller="Ogrenci" asp-action="StajBilgileri">
                        <svg aria-hidden="true"><use href="#icon-calendar"></use></svg>
                        <span>Staj Bilgileri</span>
                    </a>

                    <!-- BURASI DÜZELTİLDİ: Gerçek Evrak Yükle Sayfasına Yönlendirir -->
                    <a class="sidebar-link @(aktifMenu == "Ek16Yukle" ? "active" : "")" asp-controller="Ogrenci" asp-action="EvrakYukle">
                        <svg aria-hidden="true"><use href="#icon-upload"></use></svg>
                        <span>Ek-16 Yükle</span>
                    </a>

                    <!-- Diğer Menüler -->
                    <!-- Kontrol Sonucu Menüsü -->
                    <a class="sidebar-link @(aktifMenu == "KontrolSonucu" ? "active" : "")" asp-controller="Ogrenci" asp-action="KontrolSonucu">
                        <svg aria-hidden="true"><use href="#icon-check"></use></svg>
                        <span>Kontrol Sonucu</span>
                    </a>

                    <!-- Başvuru Durumu Menüsü -->
                    <a class="sidebar-link @(aktifMenu == "BasvuruDurumu" ? "active" : "")" asp-controller="Ogrenci" asp-action="BasvuruDurumu">
                        <svg aria-hidden="true"><use href="#icon-document"></use></svg>
                        <span>Başvuru Durumu</span>
                    </a>
                </nav>

                <!-- SOL ALT: ÇIKIŞ YAP -->
                <div class="sidebar-bottom">
                    <!-- BURASI DÜZELTİLDİ: Gerçek Çıkış İşlemine Yönlendirir -->
                    <a class="sidebar-link" asp-controller="Auth" asp-action="Logout">
                        <svg aria-hidden="true"><use href="#icon-exit"></use></svg>
                        <span>Giriş Ekranına Dön</span>
                    </a>
                </div>
            </aside>

            <!-- AÇILAN SAYFANIN İÇERİĞİ -->
            <main class="main-content">
                @RenderBody()
            </main>

        </div>

        <footer class="panel-footer">
            © 2026 Staj Evrak Yönetim Sistemi
        </footer>
    </div>

    <!-- =========================================
         ÖNİZLEME İŞLEMLERİ (Menü Kapanma vs.)
    ========================================== -->
    <script>
            // Kullanıcı menüsünün dışına tıklanınca menüyü kapat.
            const kullaniciMenu = document.getElementById("kullaniciMenu");
            document.addEventListener("click", function (event) {
                if (kullaniciMenu && !kullaniciMenu.contains(event.target)) {
                    kullaniciMenu.open = false;
                }
            });

            // Escape tuşuna basıldığında açık kullanıcı menüsünü kapat.
            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && kullaniciMenu && kullaniciMenu.open) {
                    kullaniciMenu.open = false;
                    const menuBasligi = kullaniciMenu.querySelector("summary");
                    if (menuBasligi) {
                        menuBasligi.focus();
                    }
                }
            });

            // Backend bağlantısı yapıldığı için form engellemeleri (event.preventDefault) SİLİNDİ.
            // Artık formlar C#'a gerçek veri gönderebilecek.
    </script>
</body>
</html>